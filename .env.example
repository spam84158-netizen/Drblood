# Clé API Groq (obligatoire, GRATUITE, sans carte bancaire) — ne JAMAIS commiter le vrai fichier .env
# Récupère la tienne sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé de compte de service Firebase (obligatoire pour l'historique des conversations et les stats).
# Génère-la depuis : Console Firebase > ⚙️ Paramètres du projet > Comptes de service
# > Générer une nouvelle clé privée. Colle ensuite le JSON TÉLÉCHARGÉ sur UNE SEULE LIGNE ici.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Modèle utilisé par défaut (voir la liste à jour sur https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Port du serveur (Render fournit sa propre variable PORT automatiquement)
PORT=3000

# Température par défaut du modèle (0 à 2)
GROQ_TEMPERATURE=0.7

# Nombre max de tokens en sortie
GROQ_MAX_TOKENS=2048

# Nombre de messages précédents à envoyer comme contexte (en plus du system prompt)
MAX_CONTEXT_MESSAGES=20

# Origine autorisée pour CORS (l'URL de ton frontend une fois déployé)
ALLOWED_ORIGIN=*

# Dossier de stockage des fichiers générés par l'IA (zip, scripts, docs...).
# Ce dossier reste éphémère sur le plan gratuit Render (repart à zéro à chaque
# redéploiement/redémarrage) — contrairement aux conversations, désormais sur Firestore.
GENERATED_DIR=./generated
